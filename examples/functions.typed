func factorial(n: Int64): Int64 {
    let base: Bool = n < 2;
    if (base) {
        return 1;
    } else {
        let previous: Int64 = n - 1;
        let partial: Int64 = factorial(previous);
        let result: Int64 = n * partial;
        return result;
    }
}
main(): Int64 {
    let result: Int64 = factorial(5);
    return result;
}
