main(): Int64 {
    let i: RefInt64 = refInt(0);
    let a: RefInt64 = refInt(0);
    let b: RefInt64 = refInt(1);
    let running: RefBool = refBool(true);
    while (!running) {
        let done: Bool = eq(!i, 5);
        if (done) {
            assign(running, false);
        } else {
            let next: Int64 = add(!a, !b);
            assign(a, !b);
            assign(b, next);
            let nextIndex: Int64 = add(!i, 1);
            assign(i, nextIndex);
        }
    }
    return !a;
}
