main(): Int64 {
    var i: Int64 = 0;
    var a: Int64 = 0;
    var b: Int64 = 1;
    var running: Bool = true;
    while (running) {
        let done: Bool = i == 5;
        if (done) {
            running = false;
        } else {
            let next: Int64 = a + b;
            a = b;
            b = next;
            let nextIndex: Int64 = i + 1;
            i = nextIndex;
        }
    }
    return a;
}
