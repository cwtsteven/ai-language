main(): Int64 {
    var i: Int64 = 0;
    var a: Int64 = 0;
    var b: Int64 = 1;
    var running: Bool = true;
    while (running) {
        let done: Bool = eq(i, 5);
        if (done) {
            running = false;
        } else {
            let next: Int64 = add(a, b);
            a = b;
            b = next;
            let nextIndex: Int64 = add(i, 1);
            i = nextIndex;
        }
    }
    return a;
}
