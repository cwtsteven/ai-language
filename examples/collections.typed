main(): Int64 {
    let empty: List<Int64> = List<Int64>();
    let first: List<Int64> = empty.add(4);
    var items: List<Int64> = first;
    let copy: List<Int64> = items;
    let second: List<Int64> = items.add(5);
    items = second;
    let n: Int64 = copy.size;
    let text: String = "a b";
    let letter: String = text[0];
    let joined: String = text + letter;
    let same: Bool = letter == "a";
    let length: Int64 = strLen(joined);
    let total: Int64 = n + length;
    if (same) { return total; } else { return 0; }
}
