func solve(numbers: ListInt64): Bool {
    let v1: Int64 = listLen(numbers);
    var u2: Int64 = 0;
    while (true) {
        let v3: Bool = eq(u2, v1);
        if (v3) {
            break;
        } else {
        }
        let v4: Int64 = listGet(numbers, u2);
        var u5: Int64 = 0;
        var u6: Int64 = 0;
        while (true) {
            let v7: Bool = eq(u5, v1);
            if (v7) {
                break;
            } else {
            }
            let v8: Int64 = listGet(numbers, u5);
            let v9: Bool = eq(v8, v4);
            if (v9) {
                let v10: Int64 = add(u6, 1);
                u6 = v10;
            } else {
            }
            let v11: Int64 = add(u5, 1);
            u5 = v11;
        }
        let v12: Bool = lt(2, u6);
        if (v12) {
            return false;
        } else {
        }
        let v13: Int64 = add(u2, 1);
        u2 = v13;
    }
    var u14: Int64 = 1;
    while (true) {
        let v15: Bool = lt(u14, v1);
        let v16: Bool = not(v15);
        if (v16) {
            return true;
        } else {
        }
        let v17: Int64 = sub(u14, 1);
        let v18: Int64 = listGet(numbers, v17);
        let v19: Int64 = listGet(numbers, u14);
        let v20: Bool = lt(v19, v18);
        if (v20) {
            return false;
        } else {
        }
        let v21: Int64 = add(u14, 1);
        u14 = v21;
    }
}
main(): Int64 { return 0; }
