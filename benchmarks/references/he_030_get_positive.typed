func solve(numbers: ListInt64): ListInt64 {
    var u1: ListInt64 = emptyList();
    let v2: Int64 = listLen(numbers);
    var u3: Int64 = 0;
    while (true) {
        let v4: Bool = eq(u3, v2);
        if (v4) {
            return u1;
        } else {
        }
        let v5: Int64 = listGet(numbers, u3);
        let v6: Bool = lt(v5, 0);
        let v7: Bool = eq(v5, 0);
        let v8: Bool = or(v6, v7);
        let v9: Bool = not(v8);
        if (v9) {
            let v10: ListInt64 = listPush(u1, v5);
            u1 = v10;
        } else {
        }
        let v11: Int64 = add(u3, 1);
        u3 = v11;
    }
}
main(): Int64 { return 0; }
