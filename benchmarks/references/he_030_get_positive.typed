func solve(numbers: List<Int64>): List<Int64> {
    var u1: List<Int64> = List<Int64>();
    let v2: Int64 = numbers.size;
    var u3: Int64 = 0;
    while (true) {
        let v4: Bool = u3 == v2;
        if (v4) {
            return u1;
        } else {
        }
        let v5: Int64 = numbers[u3];
        let v6: Bool = v5 < 0;
        let v7: Bool = v5 == 0;
        let v8: Bool = v6 || v7;
        let v9: Bool = !v8;
        if (v9) {
            let v10: List<Int64> = u1.add(v5);
            u1 = v10;
        } else {
        }
        let v11: Int64 = u3 + 1;
        u3 = v11;
    }
}
main(): Int64 { return 0; }
