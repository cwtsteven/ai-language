func solve(n: Int64): Int64 {
    var a: Int64 = 0;
    var b: Int64 = 1;
    var i: Int64 = 0;
    while (true) {
        let done: Bool = i == n;
        if (done) { return a; } else {}
        let next: Int64 = a + b;
        a = b;
        b = next;
        let nextIndex: Int64 = i + 1;
        i = nextIndex;
    }
}
main(): Int64 { return 0; }
