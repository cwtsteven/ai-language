func mod(left: Int64, right: Int64): Int64 {
    var u1: Int64 = left;
    while (true) {
        let v2: Bool = lt(u1, right);
        if (v2) {
            return u1;
        } else {
        }
        let v3: Int64 = sub(u1, right);
        u1 = v3;
    }
}
func isEven(value: Int64): Bool {
    let v4: Bool = lt(value, 0);
    var u5: Int64 = value;
    if (v4) {
        let v6: Int64 = sub(0, value);
        u5 = v6;
    } else {
    }
    let v7: Int64 = mod(u5, 2);
    let v8: Bool = eq(v7, 0);
    return v8;
}
func solve(numbers: ListInt64): Int64 {
    let v9: Int64 = listLen(numbers);
    var u10: Int64 = 1;
    var u11: Int64 = 0;
    while (true) {
        let v12: Bool = lt(u10, v9);
        let v13: Bool = not(v12);
        if (v13) {
            return u11;
        } else {
        }
        let v14: Int64 = listGet(numbers, u10);
        let v15: Bool = isEven(v14);
        if (v15) {
            let v16: Int64 = add(u11, v14);
            u11 = v16;
        } else {
        }
        let v17: Int64 = add(u10, 2);
        u10 = v17;
    }
}
main(): Int64 { return 0; }
