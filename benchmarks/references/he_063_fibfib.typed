func solve(n: Int64): Int64 {
    let small: Bool = n < 2;
    if (small) { return 0; } else {}
    var a: Int64 = 0;
    var b: Int64 = 0;
    var c: Int64 = 1;
    var i: Int64 = 2;
    while (true) {
        let done: Bool = i == n;
        if (done) { return c; } else {}
        let pair: Int64 = a + b;
        let next: Int64 = pair + c;
        a = b;
        b = c;
        c = next;
        let nextIndex: Int64 = i + 1;
        i = nextIndex;
    }
}
main(): Int64 { return 0; }
