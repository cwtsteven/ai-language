func solve(n: Int64): Bool {
    let small: Bool = n < 8;
    if (small) { return false; } else {}
    var r: Int64 = n;
    while (true) {
        let done: Bool = r < 2;
        if (done) {
            let even: Bool = r == 0;
            return even;
        } else {}
        let next: Int64 = r - 2;
        r = next;
    }
}
main(): Int64 { return 0; }
