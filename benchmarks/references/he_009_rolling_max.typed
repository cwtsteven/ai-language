func solve(numbers: List<Int64>): List<Int64> {
    let v1: Int64 = numbers.size;
    let v2: Bool = v1 == 0;
    if (v2) {
        let v3: List<Int64> = List<Int64>();
        return v3;
    } else {
    }
    let v4: Int64 = numbers[0];
    var u5: Int64 = v4;
    let v6: List<Int64> = List<Int64>();
    let v7: List<Int64> = v6.add(u5);
    var u8: List<Int64> = v7;
    var u9: Int64 = 1;
    while (true) {
        let v10: Bool = u9 == v1;
        if (v10) {
            return u8;
        } else {
        }
        let v11: Int64 = numbers[u9];
        let v12: Bool = v11 < u5;
        let v13: Bool = v11 == u5;
        let v14: Bool = v12 || v13;
        let v15: Bool = !v14;
        if (v15) {
            u5 = v11;
        } else {
        }
        let v16: List<Int64> = u8.add(u5);
        u8 = v16;
        let v17: Int64 = u9 + 1;
        u9 = v17;
    }
}
main(): Int64 { return 0; }
