func solve(numbers: ListInt64): ListInt64 {
    var u1: ListInt64 = emptyList();
    let v2: Int64 = listLen(numbers);
    var u3: Int64 = 0;
    while (true) {
        let v4: Bool = u3 == v2;
        if (v4) {
            return u1;
        } else {
        }
        let v5: Int64 = numbers[u3];
        let v6: Int64 = v5 + 1;
        let v7: ListInt64 = listPush(u1, v6);
        u1 = v7;
        let v8: Int64 = u3 + 1;
        u3 = v8;
    }
}
main(): Int64 { return 0; }
