func digit(n: Int64): Int64 {
    var r: Int64 = n;
    let negative: Bool = n < 0;
    if (negative) {
        let positive: Int64 = 0 - n;
        r = positive;
    } else {}
    while (true) {
        let done: Bool = r < 10;
        if (done) { return r; } else {}
        let next: Int64 = r - 10;
        r = next;
    }
}
func solve(a: Int64, b: Int64): Int64 {
    let x: Int64 = digit(a);
    let y: Int64 = digit(b);
    let result: Int64 = x * y;
    return result;
}
main(): Int64 { return 0; }
