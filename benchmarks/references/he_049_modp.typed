func remainder(n: Int64, p: Int64): Int64 {
    var r: Int64 = n;
    while (true) {
        let done: Bool = lt(r, p);
        if (done) { return r; } else {}
        let next: Int64 = sub(r, p);
        r = next;
    }
}
func solve(n: Int64, p: Int64): Int64 {
    var result: Int64 = 1;
    var i: Int64 = 0;
    while (true) {
        let done: Bool = eq(i, n);
        if (done) { return result; } else {}
        let doubled: Int64 = mul(result, 2);
        let next: Int64 = remainder(doubled, p);
        result = next;
        let nextIndex: Int64 = add(i, 1);
        i = nextIndex;
    }
}
main(): Int64 { return 0; }
