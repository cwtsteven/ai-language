func mod(left: Int64, right: Int64): Int64 {
    var u1: Int64 = left;
    while (true) {
        let v2: Bool = lt(u1, right);
        if (v2) {
            return u1;
        } else {
        }
        let v3: Int64 = sub(u1, right);
        u1 = v3;
    }
}
func div(left: Int64, right: Int64): Int64 {
    var u4: Int64 = 0;
    var u5: Int64 = left;
    while (true) {
        let v6: Bool = lt(u5, right);
        if (v6) {
            return u4;
        } else {
        }
        let v7: Int64 = sub(u5, right);
        u5 = v7;
        let v8: Int64 = add(u4, 1);
        u4 = v8;
    }
}
func solve(n: Int64): ListInt64 {
    var u9: Int64 = n;
    var u10: Int64 = 2;
    var u11: ListInt64 = emptyList();
    while (true) {
        let v12: Int64 = mul(u10, u10);
        let v13: Bool = lt(u9, v12);
        if (v13) {
            break;
        } else {
        }
        let v14: Int64 = mod(u9, u10);
        let v15: Bool = eq(v14, 0);
        if (v15) {
            let v16: ListInt64 = listPush(u11, u10);
            u11 = v16;
            let v17: Int64 = div(u9, u10);
            u9 = v17;
        } else {
            let v18: Int64 = add(u10, 1);
            u10 = v18;
        }
    }
    let v19: Bool = lt(1, u9);
    if (v19) {
        let v20: ListInt64 = listPush(u11, u9);
        u11 = v20;
    } else {
    }
    return u11;
}
