func mod(left: Int64, right: Int64): Int64 {
    var u1: Int64 = left;
    while (true) {
        let v2: Bool = u1 < right;
        if (v2) {
            return u1;
        } else {
        }
        let v3: Int64 = u1 - right;
        u1 = v3;
    }
}
func div(left: Int64, right: Int64): Int64 {
    var u4: Int64 = 0;
    var u5: Int64 = left;
    while (true) {
        let v6: Bool = u5 < right;
        if (v6) {
            return u4;
        } else {
        }
        let v7: Int64 = u5 - right;
        u5 = v7;
        let v8: Int64 = u4 + 1;
        u4 = v8;
    }
}
