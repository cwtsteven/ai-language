func solve(a: Int64, b: Int64): Int64 {
    let x: RefInt64 = refInt(a);
    let y: RefInt64 = refInt(b);
    while (true) {
        let xZero: Bool = eq(!x, 0);
        if (xZero) { return !y; } else {}
        let yZero: Bool = eq(!y, 0);
        if (yZero) { return !x; } else {}
        let smaller: Bool = lt(!x, !y);
        if (smaller) {
            let next: Int64 = sub(!y, !x);
            assign(y, next);
        } else {
            let next: Int64 = sub(!x, !y);
            assign(x, next);
        }
    }
}
main(): Int64 { return 0; }
